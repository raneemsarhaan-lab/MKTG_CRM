generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  role            String
  access          String    @default("user")
  capacity_hrs_wk Int       @default(40)
  /// Matches SeniorityLevel.key. A plain string rather than a relation: an
  /// unknown level resolves to the neutral rates in code, so a bad settings
  /// edit degrades to "no adjustment" instead of a page that will not render.
  seniority       String    @default("mid")
  status          String    @default("Available")
  color           String?
  avatar_url      String?
  password_hash   String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  /// Spec 006 (R5): mentions older than this minus 7 days count as read.
  inbox_since     DateTime  @default(now()) @db.Timestamptz(6)
  /// Spec 006: the Inbox panel is pinned beside the board.
  inbox_pinned    Boolean   @default(false)
  /// Spec 006: Week Momentum and Daily Spark are shown on the Board.
  show_week       Boolean   @default(false)
  /// Spec 012 (R13): the language push alerts and emails are written in.
  locale          String    @default("en")
  /// Spec 012 (R6): 'f' | 'm' | null. Arabic verbs agree with the actor; null
  /// uses a neutral phrasing.
  gender          String?
  /// Spec 012: Do not disturb, no toasts and no phone alerts.
  notify_dnd      Boolean   @default(false)
  /// Spec 012: 'instant' | 'daily' | 'off'.
  email_mode      String    @default("daily")
  /// Spec 012 (R7): last time the app was open and in use, for toasts and push.
  last_active_at  DateTime? @db.Timestamptz(6)

  tasks_owned             Task[]                @relation("TaskOwner")
  tasks_assigned          Task[]                @relation("TaskAssignee")
  tasks_created           Task[]                @relation("TaskCreator")
  comments                TaskComment[]
  project_steps           ProjectStep[]         @relation("StepAssignee")
  themes_owned            Project[]             @relation("ThemeOwner")
  mention_reads           MentionRead[]
  snoozes                 TaskSnooze[]
  sheet_columns_created   SheetColumn[]         @relation("SheetColumnCreator")
  sheet_columns_updated   SheetColumn[]         @relation("SheetColumnUpdater")
  sheet_values_updated    SheetValue[]
  /// Spec 013 R10: pinned Sheets folders, in order. Read only when sheet_pins_set; before that, the default (Content, then Video).
  sheet_pins              String[]              @db.Uuid
  sheet_pins_set          Boolean               @default(false)
  /// Spec 014 R2: the last local date the hours reminder opened or was put off, so it shows at most once a day.
  hours_prompted_on       DateTime?             @db.Date
  sheet_folders_created   SheetFolder[]         @relation("SheetFolderCreator")
  sheet_folders_updated   SheetFolder[]         @relation("SheetFolderUpdater")
  sheets_created          Sheet[]               @relation("SheetCreator")
  sheets_updated          Sheet[]               @relation("SheetUpdater")
  sheets_protected        Sheet[]               @relation("SheetProtector")
  sheet_cells_updated     SheetCell[]
  /// Spec 015: who last formatted a cell, and comments on cells.
  sheet_formats_updated   SheetFormat[]
  sheet_comments          SheetComment[]        @relation("SheetCommentAuthor")
  sheet_comments_resolved SheetComment[]        @relation("SheetCommentResolver")
  notifications           Notification[]
  task_follows            TaskFollower[]
  notification_settings   NotificationSetting[]
  push_subscriptions      PushSubscription[]
  email_digests           EmailDigest[]

  work_days         WorkDay[] @relation("WorkDayMember")
  work_days_updated WorkDay[] @relation("WorkDayUpdater")

  @@map("members")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  color       String   @default("#64748B")
  logo_url    String?
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  tasks    Task[]
  assets   BrandAsset[]
  projects Project[]

  @@map("brands")
}

/// A planned piece of work, from the Aspiring / Focus plan.
///
/// Deliberately separate from Task. A Task is a deliverable moving through the
/// nine review stages with an SLA; a Project is a plan made of steps measured
/// in days. They meet at ProjectStep.task_id, when a step is turned into
/// something the pipeline board tracks.
model Project {
  id         String    @id @default(uuid()) @db.Uuid
  /// Stable key from the planning documents, so re-importing updates rather
  /// than duplicates — and so a re-import never overwrites an edit made here.
  key        String?   @unique
  name       String
  brand_id   String?   @db.Uuid
  /// Standing work that recurs rather than finishing — monthly calendars,
  /// community management. Shown apart from work that has an end.
  standing   Boolean   @default(false)
  due_date   DateTime? @db.Date
  /// In the Focus list as well as Aspiring. Aspiring is everything.
  focus      Boolean   @default(false)
  sort_order Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  /// A content stream shown in the Content sheet (spec 009): Strategy,
  /// Newsjacking… Not every project is one; campaigns and plans stay off it.
  is_theme         Boolean  @default(false)
  /// Who runs the theme. May add pieces to it and edit its details.
  owner_id         String?  @db.Uuid
  /// How many pieces the theme should publish per period ("2 per week").
  frequency_count  Int?
  /// "week" or "month".
  frequency_period String?
  /// Who it is for: keys from the fixed audience list (src/components/content/audience.ts).
  audience         String[] @default([])

  brand   Brand?          @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  owner   Member?         @relation("ThemeOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  steps   ProjectStep[]
  tasks   Task[]
  pillars ContentPillar[]

  @@map("projects")
}

model ProjectStep {
  id            String    @id @default(uuid()) @db.Uuid
  key           String?   @unique
  project_id    String    @db.Uuid
  name          String
  duration_days Decimal   @default(0) @db.Decimal(5, 1)
  due_date      DateTime? @db.Date
  done          Boolean   @default(false)
  /// A marked point in the plan — a launch, an opening, a delivery. Set by the
  /// plan importer from the marker-name convention when a step is first
  /// created, and editable thereafter. A milestone is still ordinary planned
  /// work in every days and capacity figure; the flag marks its significance,
  /// it does not remove it from the plan.
  milestone     Boolean   @default(false)
  /// 'simple' | 'complex' when an admin has overridden the classification.
  /// Null means the workspace's duration threshold decides. Nullable on
  /// purpose: an override has to survive someone tuning the threshold.
  complexity    String?
  assignee_id   String?   @db.Uuid
  /// Set once this step has been pushed onto the pipeline board. Kept so the
  /// step can show that it is being produced, and so pushing it twice does
  /// not create two tasks.
  task_id       String?   @unique @db.Uuid
  /// Set when this step is a piece of a larger one.
  ///
  /// A sub-step breaks a step down; it is not a step in its own right. It
  /// carries no duration and no date, and every plan figure — days, capacity,
  /// workload, the week's counts — is measured over top-level steps only, so
  /// breaking a step into five does not turn one day of work into six. One
  /// level deep: a sub-step cannot itself be broken down, because a plan that
  /// needs a third level needs another project.
  parent_id     String?   @db.Uuid
  sort_order    Int       @default(0)

  project  Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee Member?       @relation("StepAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  task     Task?         @relation(fields: [task_id], references: [id], onDelete: SetNull)
  parent   ProjectStep?  @relation("StepParent", fields: [parent_id], references: [id], onDelete: Cascade)
  children ProjectStep[] @relation("StepParent")

  @@map("project_steps")
}

/// Reference material for a brand — logos, guidelines, templates.
/// Stored as URLs, like task attachments: there is no upload backend.
model BrandAsset {
  id          String   @id @default(uuid()) @db.Uuid
  brand_id    String   @db.Uuid
  filename    String
  url         String
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)

  brand Brand @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  @@map("brand_assets")
}

model ContentType {
  id         String   @id @default(uuid()) @db.Uuid
  label      String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tasks      Task[]      @relation("TaskContentType")
  sla_config SlaConfig[]

  @@map("content_types")
}

model Stage {
  id            String  @id
  label_en      String
  label_ar      String
  phase         String
  owner_role    String?
  terminal_flag Boolean @default(false)
  sort_order    Int

  tasks      Task[]
  sla_config SlaConfig[]

  @@map("stages")
}

model SlaConfig {
  stage_id           String
  content_type_label String
  max_business_days  Int    @default(1)

  stage        Stage       @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  content_type ContentType @relation(fields: [content_type_label], references: [label], onDelete: Cascade, onUpdate: Cascade)

  @@id([stage_id, content_type_label])
  @@map("sla_config")
}

model Task {
  id                   String    @id @default(uuid()) @db.Uuid
  /// Source key when a task came from an external system (ClickUp import).
  /// Unique so a re-import updates rather than duplicates.
  external_id          String?   @unique
  name                 String
  description          String?   @db.Text
  brand_id             String?   @db.Uuid
  content_type_label   String?
  platform             String?
  /// The project this work serves.
  ///
  /// The container, not a label: a project holds many tasks, and a task needs
  /// no plan step to belong to one. That distinction is the whole point —
  /// ProjectStep.task_id pairs a task with one planned step and is unique, so
  /// it could never express "all the work under this project". It stays, as
  /// optional precision, for work that genuinely is the delivery of a step.
  ///
  /// Nullable on purpose. Requiring it at intake would trade quick capture for
  /// coverage; instead the board counts what is unattached per brand, so the
  /// gap is visible rather than enforced.
  ///
  /// This replaces `campaign`, a free-text field that grouped nothing because
  /// nothing was ever typed into it — every one of the 316 tasks had it empty.
  project_id           String?   @db.Uuid
  /// Who is accountable for this task — usually whoever asked for it.
  ///
  /// Distinct from assignee_id below, which is who is doing it. They are the
  /// same person on most tasks and every imported one, but they are different
  /// facts: a manager owns a deliverable and hands the work to a designer.
  /// Nothing personal keys off this — see assignee_id.
  task_owner_id        String    @db.Uuid
  /// Who is doing the work.
  ///
  /// This is the one everything personal follows: My Day, Needs Your
  /// Attention, the bell, the board's Only me, and the capacity figures.
  /// Nullable because a task can genuinely be waiting for somebody to pick
  /// up; existing rows were backfilled from task_owner_id, which is what they
  /// meant before the two were separated.
  assignee_id          String?   @db.Uuid
  initiator_role       String
  nine_stage           Boolean   @default(false)
  status               String    @default("todo")
  stage_date           DateTime  @default(now()) @db.Date
  due_date             DateTime? @db.Date
  hours_estimate       Decimal   @default(0) @db.Decimal(5, 1)
  cover_image_url      String?
  /// A small preview of the newest image uploaded to this task.
  ///
  /// The board reads every task, and an attachment's own bytes live in
  /// TaskAttachment.data which the board query deliberately never selects —
  /// see the model comment there. So the card cannot show an uploaded picture
  /// unless something small enough to carry across 300 rows sits on the task
  /// itself. This is that: one thumbnail, longest edge 360px, re-encoded, a
  /// dozen kilobytes or so. It is set on upload and is not a user field —
  /// cover_image_url above is the one somebody chooses.
  cover_thumb          String?   @db.Text
  priority             String    @default("Medium")
  /// Spec 012 (R11): members @mentioned in the description, by id.
  description_mentions String[]  @default([]) @db.Uuid
  created_by           String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  /// Set when this task was created as a subtask from another task's brief.
  /// A subtask is an ordinary task — its own stage, SLA and owner — that
  /// happens to know its parent, so nothing else in the pipeline changes.
  parent_task_id       String?   @db.Uuid
  /// The live post's link, once the work is published (spec 008 FR-047).
  ///
  /// Any task may carry one; the video sheet shows it per clip and asks for it
  /// when a clip is moved to Published there.
  published_url        String?   @db.Text
  /// Set while a clip is dropped (spec 008 FR-060).
  ///
  /// A dropped task keeps its stage, files and comments but is left out of the
  /// board, the overview, capacity, projects and every count, until it is
  /// restored. The video sheet still shows it, greyed. Not a stage: the
  /// pipeline is untouched (Constitution §II).
  dropped_at           DateTime? @db.Timestamptz(6)
  /// The pillar inside its theme (spec 009), e.g. "AI".
  pillar_id            String?   @db.Uuid
  /// The social post's link (LinkedIn), beside published_url (spec 009).
  post_url             String?   @db.Text

  pillar             ContentPillar?    @relation(fields: [pillar_id], references: [id], onDelete: SetNull)
  parent             Task?             @relation("Subtasks", fields: [parent_task_id], references: [id], onDelete: SetNull)
  subtasks           Task[]            @relation("Subtasks")
  brand              Brand?            @relation(fields: [brand_id], references: [id])
  project            Project?          @relation(fields: [project_id], references: [id], onDelete: SetNull)
  task_owner         Member            @relation("TaskOwner", fields: [task_owner_id], references: [id])
  assignee           Member?           @relation("TaskAssignee", fields: [assignee_id], references: [id], onDelete: SetNull)
  creator            Member?           @relation("TaskCreator", fields: [created_by], references: [id])
  stage              Stage             @relation(fields: [status], references: [id])
  content_type       ContentType?      @relation("TaskContentType", fields: [content_type_label], references: [label])
  comments           TaskComment[]
  attachments        TaskAttachment[]
  project_step       ProjectStep?
  /// The clip details, when this task is a clip of a video (spec 008).
  clip               TaskClip?         @relation("ClipDetails")
  /// On a video: the details of its clips, for the one-file-name-per-video rule.
  video_clips        TaskClip[]        @relation("VideoClips")
  snoozes            TaskSnooze[]
  sheet_values       SheetValue[]
  /// Spec 013: row heights on the linked sheets.
  linked_row_heights LinkedRowHeight[]
  notifications      Notification[]
  followers          TaskFollower[]
  due_reminders      DueReminder[]

  @@map("tasks")
}

/// One clip of a long-form video (spec 008 Video Sheet).
///
/// A clip is an ordinary task, a subtask of its video, with its own stage, SLA
/// and owner. These are the details only a cut has: which number it is, the
/// recording it came from, its file name and its in and out times. Length is
/// never stored; it is out − in.
///
/// One row per clip task. `video_id` repeats the clip's parent so that a file
/// name can be unique per video: two people pasting the same rows at once get
/// one clip, not two. NULL file names never clash.
/// A group of pieces inside one theme (spec 009): "AI", "Decision Making".
/// Removing one keeps its pieces in the theme, with no pillar.
model ContentPillar {
  id         String   @id @default(uuid()) @db.Uuid
  project_id String   @db.Uuid
  name       String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([project_id])
  @@map("content_pillars")
}

model TaskClip {
  task_id    String   @id @db.Uuid
  video_id   String?  @db.Uuid
  clip_no    Int?
  source     String?
  file_name  String?
  in_ms      Int?
  out_ms     Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  task  Task  @relation("ClipDetails", fields: [task_id], references: [id], onDelete: Cascade)
  /// SetNull: deleting a video keeps its clips, as standalone Reels with their details.
  video Task? @relation("VideoClips", fields: [video_id], references: [id], onDelete: SetNull)

  @@unique([video_id, file_name])
  @@index([video_id])
  @@map("task_clips")
}

model TaskComment {
  id         String   @id @default(uuid()) @db.Uuid
  task_id    String   @db.Uuid
  author_id  String   @db.Uuid
  body       String
  /// Members named with @ in this comment.
  ///
  /// The names are already in `body` — this is the machine-readable half, so
  /// "was I mentioned" is a query rather than a string search. It matters
  /// because two people can share a first name and a rename must not orphan a
  /// mention: the id keeps pointing at the person either way.
  mentions   String[] @db.Uuid
  /// Tasks linked with # in this comment.
  ///
  /// Same reasoning as `mentions`, one step over: the name is in `body` for a
  /// human to read and the id is here so the link survives a rename. It also
  /// keeps the chip honest — a comment written before task links existed, or
  /// one that merely happens to quote a task's name, has nothing stored and so
  /// draws no link.
  task_refs  String[] @db.Uuid
  /// Spec 012 (R4): the top-level comment this replies to. Threads are one
  /// level deep: a reply to a reply stores the top comment.
  parent_id  String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  task          Task           @relation(fields: [task_id], references: [id], onDelete: Cascade)
  author        Member         @relation(fields: [author_id], references: [id])
  reads         MentionRead[]
  parent        TaskComment?   @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies       TaskComment[]  @relation("CommentReplies")
  notifications Notification[]

  @@index([parent_id])
  @@map("task_comments")
}

/// Spec 006 (R4): a member has read a comment that mentions them.
model MentionRead {
  member_id  String   @db.Uuid
  comment_id String   @db.Uuid
  read_at    DateTime @default(now()) @db.Timestamptz(6)

  member  Member      @relation(fields: [member_id], references: [id], onDelete: Cascade)
  comment TaskComment @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@id([member_id, comment_id])
  @@map("mention_reads")
}

/// Spec 006 (R6): a task put off until tomorrow in one member's Inbox.
model TaskSnooze {
  member_id String   @db.Uuid
  task_id   String   @db.Uuid
  until     DateTime @db.Timestamptz(6)

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@id([member_id, task_id])
  @@map("task_snoozes")
}

/// An attachment is one of two things, and the distinction is load-bearing.
///
/// `url` is a link to a file that lives somewhere else — every row imported
/// from ClickUp is one of these. It is short, so the board can afford to read
/// it for all 300-odd tasks at once, which it does: a task card's cover is the
/// first image attachment's url.
///
/// `data` is a file uploaded here, inlined as a data URL. There is no object
/// store behind this app and no credentials to add one, so the bytes live in
/// Postgres — the same trick brand logos and avatars already use. It is large,
/// so it is deliberately NOT selected by the board query; the task panel loads
/// it for its own task only, when the Attachments section is opened.
///
/// Never add `data` to a query that spans tasks.
model TaskAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  task_id      String   @db.Uuid
  filename     String
  url          String?
  data         String?  @db.Text
  /// The object's key in the bucket, when the file lives in object storage.
  ///
  /// The third of the three ways a row can point at bytes, and now the one new
  /// uploads take: `url` is where to read it, this is where to delete it. Kept
  /// separately from the URL because the public address is a CDN origin plus a
  /// key, and reversing that back into a key to delete an object is guesswork.
  storage_key  String?  @db.Text
  /// What the file said it was when it arrived, so the CDN can serve it as
  /// that rather than as a download.
  content_type String?
  /// Bytes, as uploaded. Null for imported rows and for the older data-URL
  /// uploads, whose size was never recorded.
  size_bytes   Int?
  uploaded_by  String?  @db.Uuid
  uploaded_at  DateTime @default(now()) @db.Timestamptz(6)
  /// On a link attachment: what the link is for, "working_doc" or "design"
  /// (spec 009). One per role per task; null for files and other links.
  link_role    String?

  task          Task           @relation(fields: [task_id], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@map("task_attachments")
}

model WorkspaceSettings {
  id                  Int     @id
  capacity_hrs_per_wk Int     @default(40)
  nine_stage_default  Boolean @default(false)

  /// How many hours one planned step-day costs. The plan is written in days;
  /// this is what turns it into hours.
  hours_per_step_day        Decimal   @default(8) @db.Decimal(4, 1)
  /// End of the capacity window. Null runs to the last dated step in scope.
  /// The start is always today and is deliberately not stored — a stored start
  /// goes stale in silence and inflates everyone's available hours.
  capacity_period_end       DateTime? @db.Date
  /// At or below this many days a step is simple, unless it says otherwise.
  complexity_threshold_days Decimal   @default(3) @db.Decimal(4, 1)
  /// Whose row receives supervision overhead. A role, never a named person.
  supervising_role          String    @default("Marketing Manager")

  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("workspace_settings")
}

/// A seniority level and what it costs.
///
/// A table rather than columns on WorkspaceSettings because this is a list the
/// settings screen renders row by row, and because a workspace that wants a
/// fourth rung should not need a migration to get one.
model SeniorityLevel {
  key              String  @id
  label            String
  /// Multiplies the duration of COMPLEX steps only. A simple step costs its
  /// planned duration whoever holds it — the premium is for difficulty.
  effort_factor    Decimal @default(1) @db.Decimal(4, 2)
  /// Share of the ADJUSTED days that becomes supervision for someone else.
  /// It compounds with the factor rather than sitting beside it.
  supervision_rate Decimal @default(0) @db.Decimal(4, 2)
  sort_order       Int     @default(0)

  @@map("seniority_levels")
}

/// A record of something an admin deleted on purpose.
///
/// Three importers run on every container start — the seed, the ClickUp
/// export, and the Aspiring/Focus plan — and each one creates whatever it
/// cannot find. That is deliberate: it is what makes them safe to re-run. But
/// it also means a plain DELETE only lasts until the next deploy, and the
/// person who removed a member watched them come back.
///
/// Deleting still deletes. This table only records that the deletion was
/// intended, so the importers can tell "never imported" apart from "imported
/// and then removed". Re-adding the same person or project clears the record.
///
/// kind: 'member' (key = email) | 'member-name' (key = lowercased name, which
/// is what the ClickUp export matches on) | 'project' | 'step' (key = the
/// plan key).
model Tombstone {
  kind       String
  key        String
  label      String?
  removed_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([kind, key])
  @@map("tombstones")
}

/// What a link in a comment turned out to be.
///
/// A preview means fetching a page a user pasted, which is slow, occasionally
/// impossible, and rude to repeat — the same Drive folder gets pasted a dozen
/// times and every reader would fetch it again. So a fetch happens once per
/// URL and the answer is kept here.
///
/// A failure is cached too, in `ok`. Plenty of links cannot be previewed at
/// all — a private Drive folder answers a signed-out fetch with a login page,
/// and the environment's network policy may not allow outbound requests in the
/// first place — and a row saying "we looked, there is nothing" is what stops
/// the card retrying on every render.
model LinkPreview {
  url         String   @id
  ok          Boolean  @default(false)
  title       String?
  description String?  @db.Text
  image_url   String?  @db.Text
  site_name   String?
  favicon     String?  @db.Text
  fetched_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("link_previews")
}

/// Spec 010 (R1): one column of a sheet the team has shaped, built-in or custom.
/// A built-in column is keyed by its code key (status, fileName…); a custom one by c:<id>.
model SheetColumn {
  id            String    @id @default(uuid()) @db.Uuid
  /// 'content' or 'video'
  sheet         String
  key           String
  /// Null = the default, translated name (built-in only).
  name          String?
  position      Int
  /// 60–600; null = default width.
  width         Int?
  /// True until someone hides or shows it; then shown_in lists the sets that show it.
  shown_default Boolean   @default(true)
  shown_in      String[]  @default([])
  /// Custom only: text · number · date · link · person · choice · checkbox
  kind          String?
  /// Choice only: [{ id, name, color }]
  options       Json      @default("[]")
  /// Custom only: soft delete, so Undo can bring it back (R10).
  deleted_at    DateTime? @db.Timestamptz(6)
  created_by    String?   @db.Uuid
  updated_by    String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  creator Member?      @relation("SheetColumnCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater Member?      @relation("SheetColumnUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  values  SheetValue[]

  @@unique([sheet, key])
  @@index([sheet, position])
  @@map("sheet_columns")
}

/// Spec 010 (R3): one custom column's value for one task, normalised by its kind.
model SheetValue {
  column_id  String   @db.Uuid
  task_id    String   @db.Uuid
  value      String   @db.Text
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  column  SheetColumn @relation(fields: [column_id], references: [id], onDelete: Cascade)
  task    Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  updater Member?     @relation(fields: [updated_by], references: [id], onDelete: SetNull)

  @@id([column_id, task_id])
  @@map("sheet_values")
}

// ─── Spec 012: task notifications (specs/012-notifications/data-model.md) ───

/// One notification for one member: a single event, or a group of the same
/// kind on the same task within 2 hours (R5). Stores facts, not a sentence;
/// the sentence is built at display time in the reader's language (R6).
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  recipient_id   String    @db.Uuid
  /// NotificationKind in src/types.
  kind           String
  /// Null once the task is deleted: the row stays in history.
  task_id        String?   @db.Uuid
  comment_id     String?   @db.Uuid
  attachment_id  String?   @db.Uuid
  stage_id       String?
  /// Newest first, at most 10. Empty for due reminders.
  actor_ids      String[]  @db.Uuid
  count          Int       @default(1)
  /// Null: never grouped (mentions, assignments, due reminders).
  group_key      String?
  first_event_at DateTime  @default(now()) @db.Timestamptz(6)
  last_event_at  DateTime  @default(now()) @db.Timestamptz(6)
  /// { task_name, snippet?, paste_count?, due_date? }
  meta           Json      @default("{}")
  read_at        DateTime? @db.Timestamptz(6)
  pushed_at      DateTime? @db.Timestamptz(6)
  emailed_at     DateTime? @db.Timestamptz(6)
  email_tries    Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  recipient  Member          @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  task       Task?           @relation(fields: [task_id], references: [id], onDelete: SetNull)
  comment    TaskComment?    @relation(fields: [comment_id], references: [id], onDelete: SetNull)
  attachment TaskAttachment? @relation(fields: [attachment_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, read_at, last_event_at(sort: Desc)])
  @@index([recipient_id, last_event_at(sort: Desc)])
  @@index([recipient_id, group_key])
  @@index([read_at])
  @@map("notifications")
}

/// A member follows a task (R3). `muted` remembers a deliberate unfollow, so
/// automatic following never undoes it.
model TaskFollower {
  task_id     String   @db.Uuid
  member_id   String   @db.Uuid
  followed_at DateTime @default(now()) @db.Timestamptz(6)
  muted       Boolean  @default(false)

  task   Task   @relation(fields: [task_id], references: [id], onDelete: Cascade)
  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@id([task_id, member_id])
  @@index([member_id])
  @@map("task_followers")
}

/// A member's choice for one kind, only where it differs from the defaults.
model NotificationSetting {
  member_id String  @db.Uuid
  kind      String
  in_app    Boolean
  push      Boolean
  email     Boolean

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@id([member_id, kind])
  @@map("notification_settings")
}

/// A device where a member allowed phone alerts (Web Push, R8).
model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  member_id  String    @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  last_ok_at DateTime? @db.Timestamptz(6)

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@map("push_subscriptions")
}

/// A due reminder that went out, so each is sent once per task, kind and date.
model DueReminder {
  task_id  String   @db.Uuid
  kind     String
  due_date DateTime @db.Date
  sent_at  DateTime @default(now()) @db.Timestamptz(6)

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@id([task_id, kind, due_date])
  @@map("due_reminders")
}

/// A daily summary email that went out, so it is sent once a day.
model EmailDigest {
  member_id String   @db.Uuid
  day       DateTime @db.Date
  sent_at   DateTime @default(now()) @db.Timestamptz(6)

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@id([member_id, day])
  @@map("email_digests")
}

// ─── Spec 013: Sheets (specs/013-spreadsheet-editing/data-model.md) ─────────

/// A folder in the Sheets section: the linked Content or Video folder, or a
/// team folder of blank sheets. Opened as one workbook.
model SheetFolder {
  id         String   @id @default(uuid()) @db.Uuid
  /// 'content' · 'video' · 'team'
  kind       String
  /// 'content' or 'video' for the two linked folders, null for team folders: one of each (R11).
  linked_key String?  @unique
  /// Team folders only; linked folders take their name from the translations.
  name       String?
  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  creator Member? @relation("SheetFolderCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater Member? @relation("SheetFolderUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  sheets  Sheet[]

  @@map("sheet_folders")
}

/// One tab in a folder: the linked Content or Video sheet, or a blank sheet.
model Sheet {
  id           String   @id @default(uuid()) @db.Uuid
  folder_id    String   @db.Uuid
  /// 'linked_content' · 'linked_video' · 'blank'
  kind         String
  /// 'linked_content' or 'linked_video' for the two linked sheets, null for blank ones.
  linked_key   String?  @unique
  /// Blank only: unique in the folder; linked sheets take their name from the translations.
  name         String?
  position     Int      @default(0)
  /// A palette key (red, orange, yellow, green, teal, blue, purple, pink, gray, black); null = no colour.
  tab_color    String?
  hidden       Boolean  @default(false)
  /// Set = protected: only this member and admins may edit.
  protected_by String?  @db.Uuid
  row_count    Int      @default(0)
  col_count    Int      @default(0)
  created_by   String?  @db.Uuid
  updated_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  folder    SheetFolder    @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  creator   Member?        @relation("SheetCreator", fields: [created_by], references: [id], onDelete: SetNull)
  updater   Member?        @relation("SheetUpdater", fields: [updated_by], references: [id], onDelete: SetNull)
  protector Member?        @relation("SheetProtector", fields: [protected_by], references: [id], onDelete: SetNull)
  rows      SheetRow[]
  cols      SheetCol[]
  cells     SheetCell[]
  formats   SheetFormat[]
  merges    SheetMerge[]
  comments  SheetComment[]

  @@index([folder_id, position])
  @@map("sheets")
}

/// A blank sheet's row: a stable id and a sortable position (R3).
model SheetRow {
  id       String @id @db.Uuid
  sheet_id String @db.Uuid
  position Float
  /// 21–400 px; null = the default.
  height   Int?

  sheet Sheet       @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  cells SheetCell[]

  @@index([sheet_id, position])
  @@map("sheet_rows")
}

/// A blank sheet's column: a stable id and a sortable position (R3).
model SheetCol {
  id       String @id @db.Uuid
  sheet_id String @db.Uuid
  position Float
  /// 40–600 px; null = the default.
  width    Int?

  sheet Sheet       @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  cells SheetCell[]

  @@index([sheet_id, position])
  @@map("sheet_cols")
}

/// One filled cell of a blank sheet. Empty cells aren't stored.
model SheetCell {
  sheet_id   String   @db.Uuid
  row_id     String   @db.Uuid
  col_id     String   @db.Uuid
  value      String   @db.Text
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  sheet   Sheet    @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  row     SheetRow @relation(fields: [row_id], references: [id], onDelete: Cascade)
  col     SheetCol @relation(fields: [col_id], references: [id], onDelete: Cascade)
  updater Member?  @relation(fields: [updated_by], references: [id], onDelete: SetNull)

  @@id([row_id, col_id])
  @@index([sheet_id])
  @@map("sheet_cells")
}

/// Spec 015 R1: a style for one cell, a whole row, a whole column or the whole
/// sheet. Keys are a blank sheet's row and column ids, or on the Content and
/// Video sheets a task id and a column key; '' means "every". Not foreign keys,
/// so undoing a row delete, or restoring a task, brings the formatting back.
model SheetFormat {
  sheet_id   String   @db.Uuid
  row_key    String
  col_key    String
  /// A CellStyle (research R3), validated by src/lib/sheet-format.ts.
  style      Json
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  sheet   Sheet   @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  updater Member? @relation(fields: [updated_by], references: [id], onDelete: SetNull)

  @@id([sheet_id, row_key, col_key])
  @@map("sheet_formats")
}

/// Spec 015 R4: merged cells on a blank sheet, by the row and column ids at its edges.
model SheetMerge {
  id         String @id @db.Uuid
  sheet_id   String @db.Uuid
  top_row    String @db.Uuid
  bottom_row String @db.Uuid
  left_col   String @db.Uuid
  right_col  String @db.Uuid

  sheet Sheet @relation(fields: [sheet_id], references: [id], onDelete: Cascade)

  @@index([sheet_id])
  @@map("sheet_merges")
}

/// Spec 015 R5: threaded comments on a cell. A thread is its first comment
/// (root_id null) and its replies; Resolve is kept on the root.
model SheetComment {
  id          String    @id @default(uuid()) @db.Uuid
  sheet_id    String    @db.Uuid
  row_key     String
  col_key     String
  root_id     String?   @db.Uuid
  author_id   String?   @db.Uuid
  body        String    @db.Text
  mentions    String[]  @default([]) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  edited_at   DateTime? @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  resolved_at DateTime? @db.Timestamptz(6)
  resolved_by String?   @db.Uuid

  sheet    Sheet          @relation(fields: [sheet_id], references: [id], onDelete: Cascade)
  root     SheetComment?  @relation("SheetCommentThread", fields: [root_id], references: [id], onDelete: Cascade)
  replies  SheetComment[] @relation("SheetCommentThread")
  author   Member?        @relation("SheetCommentAuthor", fields: [author_id], references: [id], onDelete: SetNull)
  resolver Member?        @relation("SheetCommentResolver", fields: [resolved_by], references: [id], onDelete: SetNull)

  @@index([sheet_id, row_key, col_key])
  @@index([root_id])
  @@map("sheet_comments")
}

/// A row height on a linked sheet, shared by the team (FR-045).
model LinkedRowHeight {
  /// 'linked_content' · 'linked_video'
  sheet_kind String
  task_id    String @db.Uuid
  height     Int

  task Task @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@id([sheet_kind, task_id])
  @@map("linked_row_heights")
}

/// Spec 014: one member's hours for one calendar day (theirs, not the server's).
/// No row means Missing; `off` means a day off; otherwise `hours` (0–24, quarter hours).
model WorkDay {
  member_id  String   @db.Uuid
  date       DateTime @db.Date
  hours      Decimal? @db.Decimal(4, 2)
  off        Boolean  @default(false)
  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  member  Member  @relation("WorkDayMember", fields: [member_id], references: [id], onDelete: Cascade)
  updater Member? @relation("WorkDayUpdater", fields: [updated_by], references: [id], onDelete: SetNull)

  @@id([member_id, date])
  @@index([date])
  @@map("work_days")
}
